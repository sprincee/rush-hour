    {
      "id": 10,
      "type": "stat",
      "title": "Served within 20 min (goal: 100%)",
      "description": "Level 2.3's goal: nobody waits more than 20 shop minutes, from ordering to drink ready. One real second is one shop minute. Counted exactly from the wait histogram's 20-second bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 23
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "100": {
                  "text": "Met Â· 100%"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No rush in range",
                  "color": "text"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No rush in range",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "100 * sum(increase(rush_order_total_wait_seconds_bucket{le=\"20.0\"}[$__range])) / sum(increase(rush_order_total_wait_seconds_count[$__range]))"
        }
      ]
    },
