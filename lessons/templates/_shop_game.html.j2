{# The game on a lesson page. Element ids are what web/src/game/shop-game.mjs looks for.
   Layout: the shop and the level ticket side by side on desktop (the ticket folds into a
   tab), stacked on phones. #}
<section class="game wrap" aria-label="The coffee shop game">
  <nav aria-label="Levels">
    <ol class="levels" id="levels"></ol>
  </nav>

  <div class="play">
    <div class="stage">
      {# On phones the controls float in the shop's bottom-right corner, like a game HUD. #}
      <div class="scene-box">
        {% include "_shop_stage.html.j2" %}
        <div class="controls">
          <div class="phase" id="phase" aria-label="Level progress"></div>
          <div class="group">
            <button class="ghost" id="ticket-btn" type="button" aria-label="Level ticket" hidden><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2h10v12l-2-1.2L9 14l-2-1.2L5 14l-2-1.2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M5.5 6h5M5.5 9h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span class="lbl">Ticket</span></button>
            <button class="ghost" id="mute" type="button" aria-pressed="false">Sound on</button>
            <button class="ghost" id="pause" type="button" hidden>Pause</button>
            <div class="seg" role="radiogroup" aria-label="Speed">
              <input type="radio" name="speed" id="speed-1" value="1"><label for="speed-1">1×</label>
              <input type="radio" name="speed" id="speed-2" value="2" checked><label for="speed-2">2×</label>
              <input type="radio" name="speed" id="speed-4" value="4"><label for="speed-4">4×</label>
            </div>
            <button class="ghost speed-btn" id="speed-btn" type="button" aria-label="Speed: 2×, tap to change">2×</button>
            <button type="button" class="help-btn" id="help" aria-expanded="false" aria-controls="key" aria-label="X-ray key">?</button>
          </div>
        </div>
      </div>
      <div class="shop-tags" id="shop-tags" aria-label="Design your shop"></div>
      <div class="setup" id="setup" hidden></div>
      <div class="moment" id="moment" role="status" hidden></div>
      <dl class="stats">
        <div><dt>Served <em>· 200 OK</em></dt><dd id="st-served">0</dd></div>
        <div><dt>Turned away <em>· 503</em></dt><dd id="st-rejected">0</dd></div>
        <div><dt id="lb-wait">Longest wait <em>· latency</em></dt><dd id="st-wait">–</dd></div>
        <div><dt id="lb-queue">On the rail <em>· queue depth</em></dt><dd id="st-queue">0</dd></div>
      </dl>
      <div class="goal-strip" id="goal-strip" aria-hidden="true" hidden></div>
      <p class="caption" id="caption" aria-live="polite"></p>
    </div>

    <details class="side" open>
      <summary class="side-tab">
        <span class="side-tab-label">Level ticket</span>
        <span class="side-tab-hint" aria-hidden="true"></span>
      </summary>
      <div class="tickets"><div class="ticket panel" id="panel"></div></div>
    </details>
  </div>

  <dialog class="start ticket-sheet" id="ticket-sheet" aria-label="Level ticket">
    <div class="start-top">
      <span class="stub">Level ticket</span>
      <button type="button" class="start-close" data-close aria-label="Back to the shop">✕</button>
    </div>
    <div class="sheet-body"></div>
  </dialog>

  <dialog class="start briefing" id="briefing" aria-labelledby="briefing-label">
    <div class="start-top">
      <span class="stub briefing-label" id="briefing-label">Level brief</span>
      <button type="button" class="start-close" data-close aria-label="Close the brief">✕</button>
    </div>
    <div class="slides" tabindex="0" aria-roledescription="carousel"></div>
    <div class="start-bottom">
      <button type="button" class="btn-quiet slide-back" data-back aria-label="Previous card">←</button>
      <div class="slide-dots" aria-hidden="true"></div>
      <button type="button" class="btn-primary slide-next" data-next>Next <span class="arrow">→</span></button>
    </div>
  </dialog>

  <div class="key-pop" id="key" role="dialog" aria-label="X-ray key" hidden>
    <p class="key-title">X-ray key</p>
    <ul class="key-list">
      <li><i style="background:#f2b233"></i>Request arriving at the API</li>
      <li><i style="background:#5aa2f0"></i>Waiting in the queue</li>
      <li><i style="background:#f07b3f"></i>Being worked on</li>
      <li><i style="background:#2fbf86"></i>Done: 200 OK</li>
      <li><i style="background:#ef5b55"></i>Rejected: 503</li>
    </ul>
    <p class="key-note" id="key-shape" hidden>Circles are walk-ins, diamonds are app orders.</p>
    <p class="key-note">Press the monitor on the shop, or X, to flip between the counter and the X-ray.</p>
  </div>
</section>
