{% if not fragment -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% endif -%}
<title>{% block title %}{% endblock %}</title>
<meta name="description" content="{% block description %}{% endblock %}">
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preload" href="assets/fonts/bricolage-grotesque-500-800.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="assets/fonts/atkinson-hyperlegible-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="assets/css/tokens.css">
<link rel="stylesheet" href="assets/css/site.css">
<link rel="stylesheet" href="assets/css/game.css">
{% block head %}{% endblock %}
{% if not fragment -%}
</head>
<body class="{% block body_class %}{% endblock %}">
{% endif -%}
<header class="site-header wrap">
  <a class="brand" href="index.html"><span class="brand-mark" aria-hidden="true"></span>Rush Hour</a>
  <nav class="site-nav" aria-label="Site">
    <a href="menu.html" {% if page == 'menu' %}aria-current="page"{% endif %}>Menu</a>
    <a href="about.html" {% if page == 'about' %}aria-current="page"{% endif %}>About</a>
    <a class="nav-play" href="{{ first_lesson }}.html">Play <span class="arrow">→</span></a>
  </nav>
</header>
{% block body %}{% endblock %}
{% block footer %}
<footer class="site-footer">
  <div class="wrap">
    <p>Rush Hour is an interactive system design course built by Mahad Khan.</p>
    <p class="mono"><a href="about.html">How it's built</a></p>
  </div>
</footer>
{% endblock %}
{% if not fragment -%}
</body>
</html>
{% endif -%}
