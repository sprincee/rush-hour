{% extends "base.html.j2" %}
{% block title %}{{ course.title }}{% endblock %}
{% block description %}{{ course.tagline }}{% endblock %}
{% block body_class %}home{% endblock %}
{% block body %}
<main class="hero wrap">
  <div class="hero-copy">
    <p class="stub">An interactive system design course</p>
    <h1>Learn system design by running a <span class="soft">coffee shop</span>.</h1>
    <p class="lede">{{ course.tagline }}</p>
    <div class="hero-actions">
      <a class="btn-primary" href="{{ first_lesson }}.html" data-start>Start lesson 1 <span class="arrow">→</span></a>
      <a class="btn-quiet" href="menu.html">See the menu</a>
    </div>
    <ul class="hero-facts">
      <li><strong>{{ playable | length }}</strong> lessons</li>
      <li><strong>{{ total_levels }}</strong> levels</li>
      <li>Free, in your browser</li>
    </ul>
  </div>

  <figure class="demo" aria-label="A live demo of the game">
    <div class="stage">
      {% include "_shop_stage.html.j2" %}
      <p class="caption" id="caption" aria-live="off"></p>
    </div>
    <figcaption class="demo-note"><span class="live-dot" aria-hidden="true"></span> Live demo. Press the monitor to flip to the X-ray.</figcaption>
  </figure>
</main>

{% include "_start_flow.html.j2" %}

<script type="module">
  import { startGame } from './assets/js/game/shop-game.mjs';
  import { setUpStartFlow } from './assets/js/site/start-flow.mjs';
  import * as lesson from './assets/js/lessons/lesson4.mjs';

  setUpStartFlow();
  try {
    const config = await (await fetch('assets/shop-config.json')).json();
    // The homepage demo: lesson 4.3, the app rush, with batching and a fair rule.
    const LEVEL = 2;
    const DESIGN = { policy: 'weighted', mobileEvery: 3, batch: true };
    const demo = startGame({ config, lesson, onFinish: () => setTimeout(() => demo.play(LEVEL, DESIGN), 3000) });
    demo.play(LEVEL, DESIGN);
    // Flip between the counter and the X-ray until the visitor takes over.
    let visitorFlipped = false;
    document.getElementById('xrayBtn').addEventListener('click', () => { visitorFlipped = true; });
    setInterval(() => { if (!visitorFlipped) demo.setXray(!demo.xray); }, 7000);
  } catch (err) {
    document.getElementById('caption').textContent = 'The demo shop couldn’t open. The lessons still work: press Start lesson 1.';
    throw err;
  }
</script>
{% endblock %}
{% block footer %}{% endblock %}
