{% extends "base.html.j2" %}
{% block title %}{{ lesson.heading }} · Rush Hour{% endblock %}
{% block description %}{{ lesson.description }}{% endblock %}
{% block body %}
<nav class="menu-strip" aria-label="All lessons">
  <div class="wrap">
    <span class="label">MENU</span>
    {% for group in course.groups %}
    {% if not loop.first %}<span class="group-gap" aria-hidden="true"></span>{% endif %}
    <ol>
      {% for l in group.lessons %}
      <li>
        {% if l.get('page') %}
        <a href="{{ l.page }}.html" title="Lesson {{ l.number }}: {{ l.concept }}" {% if l.page == lesson.slug %}aria-current="page"{% endif %}>{{ l.number }}</a>
        {% else %}
        <span class="off" title="Lesson {{ l.number }}: {{ l.concept }} (coming soon)">{{ l.number }}</span>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
    {% endfor %}
  </div>
</nav>

<main>
  <section class="lesson-hero wrap">
    <p class="stub">Lesson {{ lesson.number }} · {{ lesson.concept }}</p>
    <h1>{{ lesson.heading }}</h1>
    <p class="lede">{{ lesson.lede }}</p>
  </section>

  {% include "_shop_game.html.j2" %}

  <section class="section wrap">
    <div class="tickets">
      <div class="ticket up-next">
        {% if next %}
        <div>
          <p class="stub">Up next · Lesson {{ next.number }}</p>
          <p class="item">{{ next.heading }}</p>
          <p class="quiet">{{ next.coffee }}: {{ next.concept | lower }}.</p>
        </div>
        <a class="btn-primary" href="{{ next.page }}.html">Play lesson {{ next.number }} <span class="arrow">→</span></a>
        {% else %}
        <div>
          <p class="stub">Your turn</p>
          <p class="item">Help decide what's next</p>
          <p class="quiet">Six quick questions: did this help, and should the course keep going?</p>
        </div>
        <a class="btn-primary" href="survey.html">Take the survey <span class="arrow">→</span></a>
        {% endif %}
      </div>
    </div>
  </section>
</main>

<script type="module">
  import { startGame } from './assets/js/game/shop-game.mjs';
  import * as lesson from './assets/js/lessons/{{ lesson.module }}';
  try {
    const response = await fetch('assets/shop-config.json');
    if (!response.ok) throw new Error(`shop settings returned ${response.status}`);
    startGame({
      config: await response.json(),
      lesson,
      {% if next %}next: { href: '{{ next.page }}.html', title: {{ next.heading | tojson }} },{% else %}next: { href: 'survey.html', title: "Help decide what's next", label: 'Help decide what\'s next' },{% endif %}
    });
  } catch (err) {
    document.getElementById('caption').textContent = `The shop couldn't open: ${err.message}. Try reloading the page.`;
    throw err;
  }
</script>
{% endblock %}
